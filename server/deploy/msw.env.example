# /etc/msw/msw.env （chmod 600。systemd の EnvironmentFile から読む）

MSW_DATA_DIR=/home/mashi/msw-data
MSW_REPO_ROOT=/home/mashi/media-scribe-workflow

# Cloudflare Zero Trust → Access → Applications → (api.differance-lab.tokyo) → Overview
MSW_CF_TEAM_DOMAIN=<team-name>.cloudflareaccess.com
MSW_CF_AUD=<Application Audience (AUD) Tag>

# Access のポリシーと同じ（アプリ側でも二重に確かめる）。カンマ区切り
MSW_ALLOWED_EMAILS=someone@example.com
MSW_ALLOWED_ORIGINS=https://differance-lab.tokyo

# 文字起こし（bin/advanced/audio-transcribe に渡す追加引数）
MSW_TRANSCRIBE_ARGS=--device cuda --vad
MSW_TERMS_FILE=/home/mashi/media-scribe-workflow/examples/terms-orchestral.txt

# 構造化（Claude）
ANTHROPIC_API_KEY=<key>
MSW_MODEL=claude-opus-5-5
MSW_EFFORT=high

# 組版
MSW_TEX_JFONT=Noto Serif CJK JP

# 原本音声を処理後に消す（1=消す）
MSW_DELETE_INPUT=1
