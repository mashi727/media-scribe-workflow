#!/usr/bin/env python3
"""
rehearsal-sync — 一次ファイル（カメラ映像 + 別録り L/R 音声）から、
YAML 設定 1 枚で「同期・差し替え済み映像」までを全自動生成する。

一次入力（例）:
    Insta360 Ace Pro 2 の映像セグメント（video/*.mp4）
    RODE Wireless Pro の TX1/TX2 内部録音（L/*.wav, R/*.wav）

処理段（各段は既存ツールを配管）:
    1. 映像連結        （分割セグメント → ロスレス concat）
    2. L/R 連結+正規化 （concat → audio-normalize-loudnorm/peak、任意で個別ドリフト補正）
    3. 各chを映像へ個別同期（audio-sync-offset）
    4. 結合して mux    （adelay/atrim + join を 1 パスで、映像は -c:v copy 無劣化）

    重要: L(TX1)/R(TX2) は独立レコーダーで開始時刻もクロックも別。先にステレオ
    結合すると左右が数十秒ズレ得るため、各chを共通基準の「映像」へ個別に同期して
    から結合する。結合済みステレオを audio.stereo で渡した場合は 1 本として扱う。

設計:
    - 入力パスは設定ファイル基準の相対（glob 可）。テイクフォルダをどこに
      置いても、どこから実行しても動く。
    - 既定値で最小設定が動き、各段は上書き可能。
    - 中間生成物は work_dir（既定 .work）に置き、冪等に再実行できる。

Usage:
    rehearsal-sync <take_dir> --init      # フォルダを走査して take.yaml を生成
    rehearsal-sync take.yaml
    rehearsal-sync take.yaml --dry-run
    rehearsal-sync take.yaml --keep-work -v

設定スキーマは examples/take.yaml を参照。
"""
from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
import tempfile
from pathlib import Path

import yaml


SCRIPT_DIR = Path(__file__).resolve().parent
ADV = SCRIPT_DIR / "advanced"


def die(msg: str, code: int = 1) -> None:
    print(f"rehearsal-sync: error: {msg}", file=sys.stderr)
    sys.exit(code)


def log(msg: str) -> None:
    print(msg, file=sys.stderr)


def up_to_date(output: Path, inputs: list[Path]) -> bool:
    """output が存在し、全 inputs 以降に更新されていれば再利用可（True）。
    どれか 1 つでも output より新しい/欠けていれば False（作り直し）。"""
    if not output.is_file():
        return False
    try:
        omt = output.stat().st_mtime
    except OSError:
        return False
    for i in inputs:
        try:
            if not i.is_file() or i.stat().st_mtime > omt:
                return False
        except OSError:
            return False
    return True


class Runner:
    def __init__(self, dry_run: bool, verbose: bool, reuse: bool = False):
        self.dry_run = dry_run
        self.verbose = verbose
        self.reuse = reuse

    def run(self, cmd: list[str]) -> None:
        printable = " ".join(str(c) for c in cmd)
        if self.dry_run:
            log(f"    $ {printable}")
            return
        if self.verbose:
            log(f"    $ {printable}")
        res = subprocess.run([str(c) for c in cmd], check=False)
        if res.returncode != 0:
            die(f"command failed ({res.returncode}): {printable}")

    def step(self, cmd: list[str], output: Path, inputs: list[Path]) -> bool:
        """output を生成する cmd を実行。--reuse-work 時、output が全 inputs より
        新しく既存なら再実行せず再利用する（結果は不変・待ち時間だけ削減）。
        戻り値: 実行したら True、再利用でスキップなら False。"""
        if self.reuse and not self.dry_run and up_to_date(output, inputs):
            log(f"    [reuse] {output.name}（入力より新しいので再利用）")
            return False
        self.run(cmd)
        return True


def as_list(v) -> list:
    if v is None:
        return []
    return v if isinstance(v, list) else [v]


def _ci_glob(pat: str) -> str:
    """glob パターンの ASCII 英字を [xX] 文字クラスに展開し、大小どちらの拡張子
    （.wav/.WAV, .mp4/.MP4 等）にもマッチさせる。pathlib の case_sensitive 引数は
    3.12+ 専用なので、3.8+ でも動くこの方式を使う。既に [ を含む場合はユーザーが
    明示的に指定したものとみなしそのまま返す。"""
    if "[" in pat:
        return pat
    return "".join(f"[{c.lower()}{c.upper()}]" if c.isascii() and c.isalpha()
                   else c for c in pat)


def resolve_globs(base: Path, patterns: list[str]) -> list[Path]:
    """base 基準で各パターンを glob 展開し、ソート順で平坦化（大小拡張子両対応）。"""
    out: list[Path] = []
    for pat in patterns:
        p = Path(pat)
        if p.is_absolute():
            rel = _ci_glob(str(p.relative_to("/")))
            matches = sorted(Path("/").glob(rel))
            if not matches and p.exists():
                matches = [p]
        else:
            matches = sorted(base.glob(_ci_glob(pat)))
        out.extend(matches)
    return out


# ------------------------------------------------------------------
# --init : 一次ファイルのフォルダを走査して take.yaml の初版を書く
# ------------------------------------------------------------------
# 判定は「よくある置き方」に対する当て推量なので、生成物は必ず人が読んで直す前提。
# 迷った点は yaml のコメントに実測値として残し、後から検証できるようにする。
VIDEO_DIRS = ("movie", "movies", "video", "videos", "insta360", "cam", "gopro")
LEFT_DIRS = ("l", "left", "tx1", "ch1")
RIGHT_DIRS = ("r", "right", "tx2", "ch2")
STEREO_DIRS = ("stereo", "audio", "mix")
VIDEO_EXTS = (".mp4", ".mov", ".mts", ".m4v", ".mkv")
DRIFT_MIN_SEC = 3600.0      # これを超える尺はドリフト補正を既定で有効化
LONG_TAKE_SEC = 7200.0      # これを超える尺は測定窓と検証地点を増やす
BLIP_SEC = 60.0             # これ未満の音声は頭のテスト録りとみなしセッションから除外
GAP_THRESH = 120.0          # 隣接音声ファイル間にこれ以上の無録音空白があれば境界


def probe_duration(path: Path) -> float:
    r = subprocess.run(
        ["ffprobe", "-v", "error", "-show_entries", "format=duration",
         "-of", "csv=p=0", str(path)],
        capture_output=True, text=True, check=False)
    try:
        return float(r.stdout.strip())
    except ValueError:
        return 0.0


def probe_video_params(path: Path) -> str:
    """連結可否の判断材料。codec/解像度/fps を 1 行にまとめて返す。"""
    r = subprocess.run(
        ["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
         "stream=codec_name,width,height,r_frame_rate,pix_fmt",
         "-of", "csv=p=0", str(path)],
        capture_output=True, text=True, check=False)
    return r.stdout.strip()


def _find_dir(base: Path, names: tuple) -> Path | None:
    for child in sorted(base.iterdir()):
        if child.is_dir() and child.name.lower() in names:
            return child
    return None


def _media_in(d: Path, exts: tuple) -> list[Path]:
    return sorted(p for p in d.iterdir()
                  if p.is_file() and p.suffix.lower() in exts
                  and not p.name.startswith("."))


def _rel(base: Path, p: Path) -> str:
    return str(p.relative_to(base))


def find_video(base: Path) -> tuple[Path | None, list[Path]]:
    """映像フォルダと映像ファイルを返す。既知名 → cameraNN(Insta360) →
    映像を含む直下サブフォルダ → base 直下、の順で探す。"""
    d = _find_dir(base, VIDEO_DIRS)
    if d and _media_in(d, VIDEO_EXTS):
        return d, _media_in(d, VIDEO_EXTS)
    for child in sorted(base.iterdir()):
        if (child.is_dir() and re.match(r"^camera\d+$", child.name.lower())
                and _media_in(child, VIDEO_EXTS)):
            return child, _media_in(child, VIDEO_EXTS)
    for child in sorted(base.iterdir()):
        if child.is_dir() and _media_in(child, VIDEO_EXTS):
            return child, _media_in(child, VIDEO_EXTS)
    vf = _media_in(base, VIDEO_EXTS)
    return (None, vf) if vf else (None, [])


def video_session_key(p: Path) -> str:
    """末尾の連番を落としてセッション鍵を得る
    （VID_20260829_132715_001 → VID_20260829_132715）。連番が無ければ stem 全体。"""
    m = re.match(r"^(.*)_(\d+)$", p.stem)
    return m.group(1) if m else p.stem


def session_tag(key: str) -> str:
    """セッション鍵から日付_時刻を取り出す（出力名・work_dir 用）。無ければ鍵を流用。"""
    m = re.search(r"\d{8}_\d{6}", key)
    if m:
        return m.group(0)
    return re.sub(r"[^0-9A-Za-z_]+", "_", key).strip("_") or "take"


def _classify_wav(p: Path) -> str | None:
    """ファイル名サフィックスから L/R を判定（_L/_TX1 → left, _R/_TX2 → right）。"""
    n = p.stem.lower()
    if n.endswith("_l") or "_tx1" in n:
        return "left"
    if n.endswith("_r") or "_tx2" in n:
        return "right"
    return None


def find_audio(base: Path) -> dict:
    """base 配下（サブフォルダ含む）の wav を L/R に分類。ファイル名サフィックス
    (_L/_TX1, _R/_TX2) を最優先。無ければ L/R フォルダ → stereo フォルダ →
    base 直下、の順に従来検出。隠しフォルダ（.work 等）は除外。"""
    wavs = sorted(
        p for p in base.rglob("*")
        if p.is_file() and p.suffix.lower() == ".wav"
        and not any(part.startswith(".") for part in p.relative_to(base).parts))
    left = [p for p in wavs if _classify_wav(p) == "left"]
    right = [p for p in wavs if _classify_wav(p) == "right"]
    if left and right:
        return {"left": left, "right": right}
    ldir, rdir = _find_dir(base, LEFT_DIRS), _find_dir(base, RIGHT_DIRS)
    if ldir and rdir and _media_in(ldir, (".wav",)) and _media_in(rdir, (".wav",)):
        return {"left": _media_in(ldir, (".wav",)),
                "right": _media_in(rdir, (".wav",))}
    sdir = _find_dir(base, STEREO_DIRS)
    sfiles = _media_in(sdir, (".wav",)) if sdir else _media_in(base, (".wav",))
    if not sfiles:
        sfiles = wavs
    return {"stereo": sfiles}


def cluster_audio(files: list[Path]) -> tuple[list[list[Path]], str]:
    """連番 wav を録音セッションに割る。録音時刻(mtime)に情報があれば無録音の空白で、
    無ければ尺構造（自動分割チャンク→端数で閉じる）で分割し、各セッション先頭の
    短尺テスト録りを除く。戻り値: (セッションのリスト, 使った方式の説明)。"""
    if not files:
        return [], ""
    info = [(p, probe_duration(p), p.stat().st_mtime) for p in files]
    mtimes = [m for _, _, m in info]
    use_mtime = (max(mtimes) - min(mtimes)) > 600
    chunk = 0.0
    if use_mtime:
        method = "録音時刻(mtime)の空白"
    else:
        method = "尺構造（自動分割チャンク＋端数）"
        nonblip = [round(d) for _, d, _ in info if d >= BLIP_SEC]
        chunk = float(max(set(nonblip), key=nonblip.count)) if nonblip else \
            float(max((round(d) for _, d, _ in info), default=0))
    segments: list[list[tuple]] = []
    cur = [info[0]]
    for prev, item in zip(info, info[1:]):
        _, d0, m0 = prev
        _, d1, m1 = item
        if use_mtime:
            boundary = (m1 - m0) - d1 > GAP_THRESH   # 連続なら~0、境界で正に開く
        else:
            boundary = d0 < chunk * 0.98             # 端数の次で新セッション
        if boundary:
            segments.append(cur)
            cur = [item]
        else:
            cur.append(item)
    segments.append(cur)
    sessions = []
    for seg in segments:
        keep = [p for p, d, _ in seg if d >= BLIP_SEC]
        if keep:
            sessions.append(keep)
    return sessions, method


def scan_sessions(base: Path) -> list[dict]:
    """テイクフォルダを走査し、セッションごとの材料（映像/音声/実測値/警告）を返す。
    映像1セッションなら 1 要素、複数なら時系列順に複数要素。"""
    vdir, vfiles = find_video(base)
    if not vfiles:
        die(f"映像が見つかりません: {base}\n"
            f"（探した場所: {base.name}/ 直下, {'|'.join(VIDEO_DIRS)}/, "
            f"camera*/, 映像を含む直下サブフォルダ）")

    # 映像をセッション鍵でグループ化（鍵の昇順＝時系列）
    vgroups: dict[str, list[Path]] = {}
    for p in vfiles:
        vgroups.setdefault(video_session_key(p), []).append(p)
    vkeys = sorted(vgroups)

    audio = find_audio(base)
    warn_global: list[str] = []

    if "left" in audio:
        lsess, amethod = cluster_audio(audio["left"])
        rsess, _ = cluster_audio(audio["right"])
        amode, acount = "lr", len(lsess)
        if len(lsess) != len(rsess):
            warn_global.append(
                f"L と R のセッション数が違う（L{len(lsess)}/R{len(rsess)}）。"
                "分割の推定が外れている可能性。各 audio: を目視で直すこと")
    elif audio.get("stereo"):
        ssess, amethod = cluster_audio(audio["stereo"])
        amode, acount = "stereo", len(ssess)
        warn_global.append(
            "L/R 別ソースが見つからず stereo として扱った。別録り 2ch なら "
            "audio.left / audio.right に直すこと")
    else:
        die(f"音声が見つかりません: {base}")

    if acount == 0:
        die("音声セッションを判別できません（全ファイルが短尺 or 走査失敗）")
    if len(vkeys) != acount:
        warn_global.append(
            f"映像セッション数({len(vkeys)}) と 音声セッション数({acount}) が不一致。"
            "時系列で先頭から対応づけたが、対応がずれている可能性。要確認")

    sessions: list[dict] = []
    for i in range(min(len(vkeys), acount)):
        key = vkeys[i]
        vf = vgroups[key]
        ext = vf[0].suffix.lower()
        vdir_rel = f"{_rel(base, vdir)}/" if vdir else ""
        params = {probe_video_params(v) for v in vf}
        warns = list(warn_global)
        if len(params) > 1:
            warns.append("映像セグメントのパラメータが揃っていません"
                         "（無劣化連結に失敗）: " + " / ".join(sorted(params)))
        s: dict = {
            "tag": session_tag(key),
            "video_files": vf,
            "video_pattern": f"{vdir_rel}{key}_*{ext}",
            "video_params": sorted(params)[0] if params else "",
            "audio_method": amethod,
            "warnings": warns,
        }
        if amode == "lr":
            s["left_files"] = lsess[i]
            s["right_files"] = rsess[i] if i < len(rsess) else []
        else:
            s["stereo_files"] = ssess[i]
        sessions.append(s)
    return sessions


def render_session_yaml(base: Path, f: dict, multi: bool) -> str:
    vdur = sum(probe_duration(p) for p in f["video_files"])
    tag = f["tag"]
    yname = f"take_{tag}.yaml" if multi else "take.yaml"
    hdr = f"# {base.name}"
    if multi:
        hdr += f" / セッション {tag}"
    lines = [
        f"{hdr} — rehearsal-sync 設定（--init 生成。必ず目を通すこと）",
        "#",
        f'#   rehearsal-sync "{yname}" --dry-run     # 計画だけ確認',
        f'#   rehearsal-sync "{yname}"               # 実行',
        "#",
        "# 走査で分かった実測値:",
        f"#   映像 {len(f['video_files'])}本  {f['video_params']}  計 {vdur:.1f}s"
        f" = {vdur/3600:.2f}h",
    ]
    if "left_files" in f:
        ldur = sum(probe_duration(p) for p in f["left_files"])
        rdur = sum(probe_duration(p) for p in f["right_files"])
        lines += [f"#   L {len(f['left_files'])}本 計 {ldur:.1f}s"
                  f" / R {len(f['right_files'])}本 計 {rdur:.1f}s"
                  f"  （音声分割: {f['audio_method']}）"]
        gap = max(ldur, rdur) - vdur
        if abs(gap) > 60:
            lines += [f"#   音声が映像より {gap/60:+.1f} 分長い（録り始め/止めの差。"
                      "頭合わせは自動検出）"]
    else:
        sdur = sum(probe_duration(p) for p in f["stereo_files"])
        lines += [f"#   stereo {len(f['stereo_files'])}本 計 {sdur:.1f}s"
                  f"  （音声分割: {f['audio_method']}）"]
    for w in f["warnings"]:
        lines.append(f"# 要確認: {w}")

    drift_on = vdur > DRIFT_MIN_SEC
    long_take = vdur > LONG_TAKE_SEC
    lines += [
        "",
        "version: 1",
        "",
        "video:",
        f'  - "{f["video_pattern"]}"',
        "",
        "audio:",
    ]
    if "left_files" in f:
        lines.append("  left:")
        lines += [f'    - "{_rel(base, p)}"' for p in f["left_files"]]
        lines.append("  right:")
        lines += [f'    - "{_rel(base, p)}"' for p in f["right_files"]]
    else:
        lines.append("  stereo:")
        lines += [f'    - "{_rel(base, p)}"' for p in f["stereo_files"]]
    lines += [
        "",
        "normalize:",
        "  method: loudnorm          # 指示を聞き取る用途。演奏品質優先なら peak",
        "",
        "drift:",
        f"  enabled: {'true' if drift_on else 'false'}"
        + (f"             # {vdur/3600:.2f}h テイク。15ppm なら末尾で約 {vdur*15e-6:.2f}s ずれる"
           if drift_on else "            # 1時間未満なので既定は off（迷えば true でよい）"),
    ]
    if drift_on:
        lines.append(f"  window: {240 if long_take else 120}"
                     + ("               # 長尺なので測定窓を広げる（既定 120）"
                        if long_take else "               # 既定値"))
    lines += ["", "sync:", "  verify: true"]
    if long_take:
        lines.append("  verify_probes: 7          # 2時間超なので既定の5より増やす")
    if "left_files" in f:
        lines.append("  channel_drift_correct: true  # 別ソース L/R を密着させる")
    lines += [
        "",
        "output:",
        f'  name: "{tag}"             # 出力名（拡張子は codec から）。適宜改名可',
        "                            #   ※ 数字_数字 は引用符必須（YAML が桁区切りの整数と解釈し _ が消える）",
        "  codec: aac                # 音声コーデック",
        "  bitrate: 320k",
        "  video:                    # 「最初のエンコード」を軽い 480p プロキシに（chaptr でチャプター打ち用）",
        "    height: 480             # 16:9 → 854x480（GPU/VideoToolbox）。原盤画質が要るなら video: を丸ごと削れば -c:v copy",
        "    codec: hevc             # hevc(GPU) | h264(GPU)",
        "    bitrate: 1.2M",
    ]
    if multi:
        lines += ["", f"work_dir: .work_{tag}"]
    lines.append("")
    return "\n".join(lines)


def cmd_init(target: Path, force: bool) -> int:
    if not target.is_dir():
        die(f"--init にはテイクフォルダを渡してください: {target}")
    base = target.resolve()
    sessions = scan_sessions(base)
    if not sessions:
        die(f"セッションが見つかりません: {base}")
    multi = len(sessions) > 1
    outs: list[tuple[Path, dict]] = []
    for s in sessions:
        yname = f"take_{s['tag']}.yaml" if multi else "take.yaml"
        out = base / yname
        if out.exists() and not force:
            die(f"既にあります: {out}\n上書きしてよければ --force を付けてください")
        outs.append((out, s))
    for out, s in outs:
        out.write_text(render_session_yaml(base, s, multi), encoding="utf-8")
        log(f"rehearsal-sync: wrote {out.name}")
        for w in s["warnings"]:
            log(f"  要確認: {w}")
    if multi:
        log(f"  {len(outs)} セッションを検出。各 yaml を確認してから実行:")
        for out, _ in outs:
            log(f'    rehearsal-sync "{out.name}" --dry-run')
        log(f"  （{base} で実行）")
    else:
        log(f"  中身を確認したら: rehearsal-sync {outs[0][0].name} "
            f"--dry-run  （{base} で実行）")
    return 0


def concat_media(runner: Runner, tool: str, inputs: list[Path], output: Path,
                 extra: list[str] | None = None) -> Path:
    """配管の *-concat を呼んでロスレス連結。1 本ならそのまま返す（連結不要）。"""
    if len(inputs) == 1:
        return inputs[0]
    runner.step([str(ADV / tool), *[str(p) for p in inputs],
                 "-o", str(output), *(extra or [])], output, inputs)
    return output


def normalize_channel(runner: Runner, method: str, norm: dict,
                      src: Path, dst: Path) -> Path:
    """1 チャンネルを正規化。method=none はそのまま返す。"""
    if method == "none":
        return src
    if method == "loudnorm":
        runner.step([
            ADV / "audio-normalize-loudnorm", str(src), "-o", str(dst),
            "-i", str(norm.get("I", -14)),
            "-tp", str(norm.get("TP", -1.5)),
            "-lra", str(norm.get("LRA", 11)),
            "--bit-depth", str(norm.get("bit_depth", "24")),
        ], dst, [src])
    elif method == "peak":
        runner.step([
            ADV / "audio-normalize-peak", str(src), "-o", str(dst),
            "--bit-depth", str(norm.get("bit_depth", "24")),
        ], dst, [src])
    else:
        die(f"unknown normalize.method: {method}")
    return dst


def audio_sample_rate(path: Path) -> int:
    r = subprocess.run(
        ["ffprobe", "-v", "error", "-select_streams", "a:0",
         "-show_entries", "stream=sample_rate", "-of", "csv=p=0", str(path)],
        capture_output=True, text=True, check=False,
    )
    try:
        return int(r.stdout.strip())
    except ValueError:
        return 48000


def measure_offset(video: Path, audio: Path, rate: int) -> tuple[float, float]:
    """audio-sync-offset を実行して (オフセット秒, 信頼度スコア) を返す（実行モード専用）。

    スコアは相関ピークの z 値。低い場合は「映像と音声に共通の音が無い」または
    「video: の複数クリップが時間的に不連続」を意味し、そのまま進めると
    まったく別の音声が乗った成果物ができるため、呼び出し側で検証する。"""
    r = subprocess.run(
        [str(ADV / "audio-sync-offset"), str(video), str(audio),
         "--rate", str(rate), "--json"],
        capture_output=True, text=True, check=False,
    )
    if r.returncode != 0:
        die(f"audio-sync-offset failed for {audio}: {r.stderr.strip()}")
    try:
        d = json.loads(r.stdout)
        return float(d["offset"]), float(d["score"])
    except (json.JSONDecodeError, KeyError, ValueError) as e:
        die(f"could not parse audio-sync-offset output for {audio}: {e}")


def verify_alignment(video: Path, audio: Path, offset: float, rate: int,
                     probes: int, window: float, min_score: float,
                     tol: float, label: str) -> bool:
    """audio-sync-verify で「動画全域」の整合を確認する（実行モード専用）。

    全体相関のスコアが高くても一部しか一致していない場合（例: 時間を空けて撮った
    複数クリップの連結）を検出するため、単一スコアではなく複数地点で検証する。"""
    log(f"    [verify {label}] 複数地点で整合性を検証...")
    r = subprocess.run(
        [str(ADV / "audio-sync-verify"), str(video), str(audio),
         "--offset", f"{offset:.6f}", "--probes", str(probes),
         "--window", str(window), "--rate", str(rate),
         "--min-score", str(min_score), "--tolerance", str(tol)],
        check=False,
    )
    return r.returncode == 0


def assert_channels_coherent(l_src: Path, r_src: Path, off_l: float, off_r: float,
                             rate: int, probes: int, window: float,
                             min_score: float, tol: float, force: bool) -> None:
    """L と R の *相対* 整合を検証する。

    なぜ要るか: 各チャンネルは映像へ個別に同期される。映像に対する残差が
    それぞれ許容内（例 ±0.1s）でも、両者の差はその 2 倍まで開きうる。
    人間の耳は L/R 間の時間差を 1〜2ms で音像の偏りとして知覚するので、
    映像基準の tolerance では粗すぎる。実際に 29ms のずれを聞き取られた事例がある。

    ずれが時間とともに増える場合はドリフト補正の残差が食い違っている。
    その場合は片方を他方へ合わせる（定数シフト＋atempo）必要がある。
    """
    log("    [verify L↔R] チャンネル間の相対整合を検証...")
    r = subprocess.run(
        [str(ADV / "audio-sync-verify"), str(l_src), str(r_src),
         "--offset", f"{off_r - off_l:.6f}", "--probes", str(probes),
         "--window", str(window), "--rate", str(rate),
         "--min-score", str(min_score), "--tolerance", str(tol)],
        check=False,
    )
    if r.returncode == 0:
        return
    msg = (f"L↔R の相対整合が許容 {tol*1000:.0f}ms を超えています。\n"
           f"  各chは映像に対しては合っていても、左右の差は音像の偏りとして聞こえます。\n"
           f"  残差が時刻とともに増えているなら、ドリフト補正の残差が食い違っています。\n"
           f"  対処: sync.channel_tolerance を実態に合わせる / drift.window を広げて\n"
           f"        再測定する / --force で強行する")
    if not force:
        die(msg)
    log(f"    WARNING: {msg}")


def assert_sync_ok(video: Path, results: list, min_score: float, verify_on: bool,
                   probes: int, window: float, tol: float, rate: int,
                   force: bool) -> None:
    """同期結果を検証し、問題があれば中断する。

    results: [(label, audio_path, offset, score), ...]
    2 段構え:
      1) 全体相関スコア — 共通の音が無い/対応素材が違う場合を弾く
      2) 複数地点の整合 — スコアが高くても「一部だけ一致」を弾く
         （時間を空けて撮った複数クリップの連結など）"""
    weak = [(n, s) for n, _, _, s in results if s < min_score]
    if weak and not force:
        detail = ", ".join(f"{n} score={s:.1f}" for n, s in weak)
        die(f"同期の信頼度が低い（{detail} < sync.min_score {min_score:g}）。\n"
            f"  想定原因:\n"
            f"    (1) video: の複数クリップが時間的に不連続（連続タイムラインが前提。\n"
            f"        間を空けて撮った別クリップは先頭以外がズレます）\n"
            f"    (2) 映像と音声に共通の音が入っていない / 対応する素材が違う\n"
            f"  対処: 入力の対応を確認、または --force で強行 / sync.min_score を下げる")
    if weak:
        log(f"    WARNING: 信頼度が低いまま --force で続行します（{len(weak)} 系統）")

    if not verify_on:
        return
    bad = [n for n, p, o, _ in results
           if not verify_alignment(video, p, o, rate, probes, window,
                                   min_score, tol, n)]
    if bad and not force:
        die(f"整合性検証に失敗（{', '.join(bad)}）。\n"
            f"  上の NG 行の位置で映像と音声が対応していません。\n"
            f"  最も多い原因: video: の複数クリップが時間的に不連続\n"
            f"    （連結は 1 本の連続タイムラインが前提。間を空けて撮った\n"
            f"      別クリップは先頭以外に別の音声が乗ります）\n"
            f"  対処: クリップ毎に take.yaml を分ける / --force で強行 /\n"
            f"        sync.verify: false で検証を切る")
    if bad:
        log("    WARNING: 整合性検証に失敗したまま --force で続行します")


def acodec_args(codec: str, bitrate: str) -> tuple[list[str], str]:
    """(ffmpeg 音声コーデック引数, 推奨コンテナ拡張子) を返す。"""
    if codec == "aac":
        return (["-c:a", "aac", "-b:a", bitrate], "mp4")
    if codec == "pcm":
        return (["-c:a", "pcm_s24le"], "mov")
    if codec == "alac":
        return (["-c:a", "alac"], "mov")
    if codec == "copy":
        return (["-c:a", "copy"], "mkv")
    die(f"unknown output.codec: {codec}")


def channel_filter(idx: int, offset: float, sr: int, label: str) -> str:
    """入力 idx の音声を offset[秒] だけ映像 timeline に合わせて焼き込むフィルタ。
    offset>=0 は adelay（先頭無音）、offset<0 は atrim（先頭トリム）。apad で末尾を埋め、
    最終段の -shortest で映像長にそろえる。"""
    ns = round(abs(offset) * sr)
    if offset >= 0:
        return f"[{idx}:a]adelay={ns}S:all=1,apad[{label}]"
    return f"[{idx}:a]atrim=start_sample={ns},asetpts=PTS-STARTPTS,apad[{label}]"


VT_ENCODERS = {"hevc": "hevc_videotoolbox", "h265": "hevc_videotoolbox",
               "h264": "h264_videotoolbox", "avc": "h264_videotoolbox"}


def video_encode_plan(out_cfg: dict) -> tuple[str | None, str, list[str], bool]:
    """output.video から映像の (scale フィルタ|None, 映像 map, ffmpeg 引数, hwaccel要否)。

    output.video を書かなければ従来どおり -c:v copy（無劣化・瞬時）。書けば GPU
    (VideoToolbox) で scale+再エンコード（chaptr でのチャプター打ち用の軽い 480p 等。
    巨大な原盤を作らず、この 1 パスで直接プロキシを吐く）。
      video:
        height: 480        # scale=-2:height（16:9 → 854x480）
        codec: hevc        # hevc/h265(GPU) | h264/avc(GPU)。既定 hevc
        bitrate: 1.2M      # 既定 1.2M
    """
    vconf = out_cfg.get("video")
    if not vconf:
        return None, "0:v:0", ["-c:v", "copy"], False
    height = int(vconf.get("height", 480))
    codec = str(vconf.get("codec", "hevc")).lower()
    enc = VT_ENCODERS.get(codec)
    if enc is None:
        die(f"unknown output.video.codec: {codec}（hevc|h264）")
    bitrate = str(vconf.get("bitrate", "1.2M"))
    tag = "hvc1" if "hevc" in enc else "avc1"
    return (f"[0:v]scale=-2:{height}[v]", "[v]",
            ["-c:v", enc, "-b:v", bitrate, "-tag:v", tag, "-g", "30"], True)


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="rehearsal-sync",
        description="YAML 1 枚で一次ファイルから同期・差し替え済み映像を生成。",
    )
    ap.add_argument("config", help="take.yaml のパス（--init のときはテイクフォルダ）")
    ap.add_argument("--init", action="store_true",
                    help="テイクフォルダを走査して take.yaml を生成し終了する。"
                         "既存の take.yaml は上書きしない（--force で上書き）")
    ap.add_argument("--dry-run", action="store_true", help="実行せず計画を表示")
    ap.add_argument("--keep-work", action="store_true", help="中間生成物を消さない")
    ap.add_argument("--reuse-work", action="store_true",
                    help="既存の中間生成物(.work)が入力より新しければ再利用し、その工程を"
                         "省く（結果は不変・待ち時間だけ削減）。中間物は次回のため保持する")
    ap.add_argument("--force", action="store_true",
                    help="同期の信頼度が低くても中断せず続行する"
                         "（--init 時は take.yaml の上書きを許可）")
    ap.add_argument("-v", "--verbose", action="store_true")
    args = ap.parse_args()

    if args.init:
        return cmd_init(Path(args.config), args.force)

    cfg_path = Path(args.config).resolve()
    if not cfg_path.is_file():
        die(f"config not found: {cfg_path}")
    base = cfg_path.parent
    with open(cfg_path, encoding="utf-8") as fh:
        cfg = yaml.safe_load(fh) or {}

    runner = Runner(args.dry_run, args.verbose, args.reuse_work)

    def rel(p: str) -> Path:
        pp = Path(p)
        return pp if pp.is_absolute() else base / pp

    # --- 設定の取り出し（既定つき） ---
    norm = cfg.get("normalize") or {}
    method = norm.get("method", "loudnorm")
    drift = cfg.get("drift") or {}
    sync = cfg.get("sync") or {}
    out_cfg = cfg.get("output") or {}
    codec = str(out_cfg.get("codec", "aac"))
    bitrate = str(out_cfg.get("bitrate", "320k"))
    acodec, ext = acodec_args(codec, bitrate)
    # 映像は既定 -c:v copy（無劣化）。output.video 指定時のみ GPU で scale+再エンコード。
    vfilter, vmap, vargs, vhwaccel = video_encode_plan(out_cfg)
    # 出力先の決定（優先順）:
    #   1. output.path … フルパス指定（拡張子まで明示。最優先）
    #   2. output.name … ファイル名（拡張子なし）。拡張子は codec から自動、take 直下に置く
    #   3. どちらも無し … take フォルダ名を採用（<take>/<フォルダ名>.<ext>）
    if out_cfg.get("path"):
        output = rel(str(out_cfg["path"]))
    elif out_cfg.get("name"):
        output = rel(f"{out_cfg['name']}.{ext}")
    else:
        output = rel(f"{base.name}.{ext}")
    work = rel(cfg.get("work_dir", ".work"))

    # --- 入力の glob 解決 ---
    videos = resolve_globs(base, [str(x) for x in as_list(cfg.get("video"))])
    audio = cfg.get("audio") or {}
    lefts = resolve_globs(base, [str(x) for x in as_list(audio.get("left"))])
    rights = resolve_globs(base, [str(x) for x in as_list(audio.get("right"))])
    stereo_in = resolve_globs(base, [str(x) for x in as_list(audio.get("stereo"))])

    if not videos:
        die("no video inputs matched (check `video:` globs)")
    if not stereo_in and (not lefts or not rights):
        die("no audio inputs matched (need audio.left+audio.right or audio.stereo)")

    log("=" * 60)
    log(f"rehearsal-sync: {cfg_path.name}")
    log(f"  base dir   : {base}")
    def _show(p: Path):
        try:
            return p.relative_to(base)   # is_relative_to は 3.9+ なので使わない
        except ValueError:
            return p

    log(f"  video      : {len(videos)} file(s)")
    for v in videos:
        log(f"                 - {_show(v)}")
    if stereo_in:
        log(f"  stereo     : {len(stereo_in)} file(s)")
    else:
        log(f"  audio L    : {len(lefts)} file(s)")
        log(f"  audio R    : {len(rights)} file(s)")
    log(f"  normalize  : {method}")
    log(f"  drift      : {'on' if drift.get('enabled') else 'off'}")
    log(f"  video enc  : {vargs[1]}"
        + ("（GPU/VideoToolbox 再エンコード）" if vhwaccel else "（copy 無劣化）"))
    log(f"  output     : {output}")
    log(f"  work_dir   : {work}")
    log("=" * 60)

    if not args.dry_run:
        work.mkdir(parents=True, exist_ok=True)
        output.parent.mkdir(parents=True, exist_ok=True)

    # --- 1. 映像連結 ---
    log("[1/4] 映像連結")
    video_single = concat_media(runner, "video-concat", videos, work / "video.mp4")

    rate = int(sync.get("rate", 8000))
    min_score = float(sync.get("min_score", 10))
    verify_on = bool(sync.get("verify", True))
    verify_probes = int(sync.get("verify_probes", 5))
    verify_window = float(sync.get("verify_window", 30))
    tolerance = float(sync.get("tolerance", 0.5))
    drift_on = bool(drift.get("enabled"))
    drift_win = str(drift.get("window", 120))

    if stereo_in:
        # 既に相互整合したステレオ音源 → 1 本として映像へ同期
        log("[2/4] 音声連結 + 正規化（stereo 指定）"
            + ("（+ ドリフト補正）" if drift_on else ""))
        st_concat = concat_media(runner, "audio-concat", stereo_in, work / "stereo_concat.wav", ["--any-format"])
        stereo = normalize_channel(runner, method, norm, st_concat, work / "stereo.wav")
        if drift_on:
            runner.step([ADV / "audio-drift-correct", str(video_single), str(stereo),
                         "-o", str(work / "stereo_fix.wav"), "--window", drift_win,
                         "--bit-depth", str(norm.get("bit_depth", "24"))],
                        work / "stereo_fix.wav", [video_single, stereo])
            stereo = work / "stereo_fix.wav"

        log("[3/4] 映像へ同期 → [4/4] mux")
        if args.dry_run:
            log("    $ (audio-sync-offset で測定・検証 → adelay/atrim で mux)")
            log(f"    $ ffmpeg {'-hwaccel videotoolbox ' if vhwaccel else ''}"
                f"-i {video_single} -i {stereo} "
                f"-filter_complex '{(vfilter + ';') if vfilter else ''}[1:a]adelay=<D>[a]' "
                f"-map {vmap} -map [a] "
                f"{' '.join(vargs)} {' '.join(acodec)} -shortest {output}")
        else:
            sr = audio_sample_rate(stereo)
            off, sc = measure_offset(video_single, stereo, rate)
            log(f"    offset = {off:+.4f}s (score {sc:.1f})   (@ {sr}Hz)")
            assert_sync_ok(video_single, [("stereo", stereo, off, sc)],
                           min_score, verify_on, verify_probes, verify_window,
                           tolerance, rate, args.force)
            afc = channel_filter(1, off, sr, "a")
            fc = f"{vfilter};{afc}" if vfilter else afc
            runner.run([
                "ffmpeg", "-hide_banner", "-y", "-v", "warning", "-stats",
                *(["-hwaccel", "videotoolbox"] if vhwaccel else []),
                "-i", str(video_single), "-i", str(stereo),
                "-filter_complex", fc,
                "-map", vmap, "-map", "[a]",
                *vargs, *acodec,
                "-shortest", str(output),
            ])
    else:
        # L/R は独立録音（開始時刻・クロックが別）。各チャンネルを個別に映像へ
        # 同期してから結合する（先に結合すると左右が数十秒ズレる）。
        log("[2/4] L/R 連結 + 正規化" + ("（+ 個別ドリフト補正）" if drift_on else ""))
        l_concat = concat_media(runner, "audio-concat", lefts, work / "L_concat.wav", ["--any-format"])
        r_concat = concat_media(runner, "audio-concat", rights, work / "R_concat.wav", ["--any-format"])
        l_src = normalize_channel(runner, method, norm, l_concat, work / "L.wav")
        r_src = normalize_channel(runner, method, norm, r_concat, work / "R.wav")
        if drift_on:
            for src, dst in ((l_src, work / "L_fix.wav"), (r_src, work / "R_fix.wav")):
                runner.step([ADV / "audio-drift-correct", str(video_single), str(src),
                             "-o", str(dst), "--window", drift_win,
                             "--bit-depth", str(norm.get("bit_depth", "24"))],
                            dst, [video_single, src])
            l_src, r_src = work / "L_fix.wav", work / "R_fix.wav"
            # 各chを映像へ個別に補正しても、補正残差が食い違うため L↔R には相対
            # ドリフトが残る（結合するとエコー／音像の偏りになる。映像基準は許容内でも
            # L↔R は数十msズレうる）。L を基準に R をもう一段補正して左右を密着させる。
            # ドリフトが min-ppm 未満（TC 収録など）なら audio-drift-correct はコピー
            # 出力＝実質 no-op。channel_drift_correct: false で無効化できる。
            if bool(sync.get("channel_drift_correct", True)):
                log("    R を L 基準で相対ドリフト補正（L↔R を密着させる）")
                runner.step([ADV / "audio-drift-correct", str(l_src), str(r_src),
                             "-o", str(work / "R_fix2.wav"), "--window", drift_win,
                             "--bit-depth", str(norm.get("bit_depth", "24"))],
                            work / "R_fix2.wav", [l_src, r_src])
                r_src = work / "R_fix2.wav"

        log("[3/4] 各チャンネルを映像へ個別同期 → [4/4] 結合して mux")
        if args.dry_run:
            log("    $ (各chの audio-sync-offset でオフセット測定 → adelay/atrim + join で mux)")
            log(f"    $ ffmpeg {'-hwaccel videotoolbox ' if vhwaccel else ''}"
                f"-i {video_single} -i {l_src} -i {r_src} "
                f"-filter_complex '{(vfilter + ';') if vfilter else ''}"
                f"[1:a]adelay=<DL>[la];[2:a]adelay=<DR>[ra];"
                f"[la][ra]join=inputs=2:channel_layout=stereo[a]' "
                f"-map {vmap} -map [a] {' '.join(vargs)} {' '.join(acodec)} -shortest {output}")
        else:
            sr = audio_sample_rate(l_src)
            offL, scL = measure_offset(video_single, l_src, rate)
            if drift_on and bool(sync.get("channel_drift_correct", True)):
                # R は「映像」ではなく「L」への直接オフセットで置く。各chを個別に映像へ
                # 相関させると、映像スクラッチ音（別マイク・別特性・ノイズ多）との相関
                # ピークが甘く ±10ms 級の誤差が出て、それが L↔R に ±20ms として漏れる
                # （ドリフトを消しても定常オフセットが残る）。L↔R は同一内容で相関が鋭い
                # ので、R を L への直接オフセットに乗せれば L↔R が sub-ms で密着する。
                lr_off, scR = measure_offset(l_src, r_src, rate)
                offR = offL + lr_off
            else:
                offR, scR = measure_offset(video_single, r_src, rate)
            log(f"    offset L = {offL:+.4f}s (score {scL:.1f})   "
                f"offset R = {offR:+.4f}s (score {scR:.1f})   (@ {sr}Hz)")

            assert_sync_ok(video_single,
                           [("L", l_src, offL, scL), ("R", r_src, offR, scR)],
                           min_score, verify_on, verify_probes, verify_window,
                           tolerance, rate, args.force)
            # 各chが映像に合っていても、L↔R の差は別問題（音像の偏りとして聞こえる）
            if verify_on:
                assert_channels_coherent(
                    l_src, r_src, offL, offR, rate, verify_probes, verify_window,
                    min_score, float(sync.get("channel_tolerance", 0.005)),
                    args.force)
            fc_parts = [
                channel_filter(1, offL, sr, "la"),
                channel_filter(2, offR, sr, "ra"),
                "[la][ra]join=inputs=2:channel_layout=stereo[a]",
            ]
            if vfilter:
                fc_parts.insert(0, vfilter)
            runner.run([
                "ffmpeg", "-hide_banner", "-y", "-v", "warning", "-stats",
                *(["-hwaccel", "videotoolbox"] if vhwaccel else []),
                "-i", str(video_single), "-i", str(l_src), "-i", str(r_src),
                "-filter_complex", ";".join(fc_parts),
                "-map", vmap, "-map", "[a]",
                *vargs, *acodec,
                "-shortest", str(output),
            ])

    # --- 後始末 ---（--reuse-work 時は次回再利用のため中間物を残す）
    if not args.dry_run and not args.keep_work and not args.reuse_work:
        for f in ("video.mp4", "L_concat.wav", "R_concat.wav", "L.wav", "R.wav",
                  "L_fix.wav", "R_fix.wav", "R_fix2.wav", "stereo_concat.wav",
                  "stereo.wav", "stereo_fix.wav"):
            (work / f).unlink(missing_ok=True)
        try:
            work.rmdir()
        except OSError:
            pass

    if args.dry_run:
        log("rehearsal-sync: --dry-run 完了（実行はしていません）")
    else:
        log(f"rehearsal-sync: done → {output}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
