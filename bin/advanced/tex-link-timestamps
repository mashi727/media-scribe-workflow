#!/usr/bin/env python3
"""
tex-link-timestamps — 記録 .tex のタイムスタンプを YouTube へのリンクにする。

なぜ要るか:
    この記録は「読み手が一次資料（映像）に照合できる」ことで一次資料たりうる。
    紙に時刻が印字されているだけでは、読み手は手で動画を探すことになり、
    照合が実際には行われない。**タイムスタンプ自体を検証の経路にする。**

    リンクは2つの意味を持つ:
      1. 演奏の確認 — その返しが実際にどう鳴ったかを聴く
      2. 一次資料の確認 — 記録の引用が発話と合っているかを検める

やること:
    \\ts{HH:MM:SS} を \\tsy{HH:MM:SS}{秒} に書き換え、プリアンブルに
    リンク版の \\tsy を定義する。時刻→秒の変換は Python で行う（LaTeX で
    文字列を parse すると壊れやすい）。**元の .tex は上書きしない。**

前提:
    **記録と同一タイムラインの動画であること。** 全長版を上げた動画に
    原本の時刻でリンクを張ると、休憩を除いたぶんだけ全部ずれる。
    尺を突き合わせてから使う。

Usage:
    tex-link-timestamps 記録.tex --video 25MxIZQ8JLU -o 記録_linked.tex
    tex-link-timestamps 記録.tex --video https://youtu.be/25MxIZQ8JLU --in-place

依存: Python 標準ライブラリのみ
"""
from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

TS = re.compile(r"\\ts\{(\d{1,2}):(\d{2}):(\d{2})(?:\.(\d{1,3}))?\}")
DEF = r"""
% --- YouTube へのリンク付きタイムスタンプ（tex-link-timestamps が挿入）---
% 時刻は記録の一次資料（映像）への経路である。読み手がその場で照合できるようにする。
\newcommand{\videoid}{__VID__}
\newcommand{\tsy}[2]{\href{https://youtu.be/\videoid?t=#2}{\texttt{\small [#1]}}}
"""


def die(msg: str, code: int = 1) -> None:
    print(f"tex-link-timestamps: error: {msg}", file=sys.stderr)
    sys.exit(code)


def vid_of(s: str) -> str:
    m = re.search(r"(?:youtu\.be/|[?&]v=|/embed/)([\w-]{6,})", s)
    return m.group(1) if m else s.strip()


def main() -> int:
    ap = argparse.ArgumentParser(prog="tex-link-timestamps", add_help=True)
    ap.add_argument("tex", help="記録の .tex")
    ap.add_argument("--video", required=True, help="YouTube の動画ID または URL")
    ap.add_argument("-o", "--output", help="出力（既定: <input>_linked.tex）")
    ap.add_argument("--in-place", action="store_true", help="元のファイルを書き換える")
    ap.add_argument("--offset", type=float, default=0,
                    help="記録の時刻に足す秒数（動画側が記録より前から始まる場合）")
    ap.add_argument("--force", action="store_true", help="出力先があっても上書き")
    args = ap.parse_args()

    src = Path(args.tex)
    if not src.is_file():
        die(f"not found: {src}")
    vid = vid_of(args.video)
    s = src.read_text(encoding="utf-8")

    if "\\tsy" in s:
        die("既にリンク化されています（\\tsy が定義済み）")
    if "\\usepackage{hyperref}" not in s:
        die("hyperref が読み込まれていません。リンクを張れません")

    n = 0

    def repl(m: re.Match) -> str:
        nonlocal n
        h, mi, se, _ms = m.groups()
        sec = int(h) * 3600 + int(mi) * 60 + int(se) + args.offset
        n += 1
        return f"\\tsy{{{h}:{mi}:{se}}}{{{int(max(0, sec))}}}"

    body = TS.sub(repl, s)
    if not n:
        die("\\ts{...} が見つかりません")

    # プリアンブルの \ts 定義の直後に \tsy を足す
    anchor = re.search(r"\\newcommand\{\\ts\}\[1\]\{[^\n]*\n", body)
    if not anchor:
        die("プリアンブルに \\ts の定義が見つかりません")
    body = body[:anchor.end()] + DEF.replace("__VID__", vid) + body[anchor.end():]

    out = src if args.in_place else Path(args.output or
                                         src.with_name(src.stem + "_linked.tex"))
    if out.exists() and not args.in_place and not args.force:
        die(f"出力先が既にあります: {out}（--force で上書き）")
    out.write_text(body, encoding="utf-8")
    print(f"tex-link-timestamps: {n} 箇所をリンク化 -> {out}")
    print(f"  https://youtu.be/{vid}?t=... の形式"
          + (f"（オフセット {args.offset:+g} 秒）" if args.offset else ""))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
