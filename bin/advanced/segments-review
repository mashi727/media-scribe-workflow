#!/usr/bin/env python3
"""
segments-review — 合奏1回ごとの「直前の指示」と「直後の講評」を1枚にまとめる。

何のためか:
    検出した演奏区間をそのまま眺めても、それが何の返しだったか分からない。
    返しのねらいは**直前の60〜120秒**に、評価は**直後の60秒**にほぼ必ずある。
    そこだけを抜いて並べれば、動画を頭から見直さずに中身を確認できる。

    全文の context.txt（3エンジン×全区間で数百KB）は人が読む量ではない。
    こちらは同じ材料を「1区間あたり十数行」に畳む。

複数エンジンの畳み方:
    同じ発話が3系統に別々の表記・別々の時刻で出る（Whisper は長い区間を1 cue に
    まとめ、Deepgram は細かく切るので、同一発話でも開始が数秒ずれる）。
    そこで **長い版から順に採用し、前後 --dup-window 秒に似た版があれば断片として
    捨てる**。内容が違えば残るので、片方だけが拾った指示は落ちない。
    要約はしない。校正もしない。**残るのは必ず実在の発話**（選択であって生成ではない）。

    実測: 3系統 2479 発話 → 1562 発話。

Usage:
    segments-review --segments segments.json --sub a.srt --sub b.srt -o review.md
    segments-review --segments segments.json --sub *.srt \\
        --chapters 原本.txt --before 90 --after 60 -o review.md

依存: Python 標準ライブラリのみ
"""
from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path

CUE_RE = re.compile(
    r"(\d\d):(\d\d):(\d\d)[,.](\d{1,3})\s*-->\s*(\d\d):(\d\d):(\d\d)[,.](\d{1,3})\s*\n(.*?)(?=\n\s*\n|\Z)",
    re.S)
CHAP_RE = re.compile(r"^\s*(\d+):(\d\d):(\d\d)[.,](\d{1,3})\s+(.*\S)\s*$")
# 意味を持たない相槌だけの行は確認の邪魔になるので落とす
