 <div class="foot">判定は自動保存されます（ブラウザを閉じても残ります）。
  ※=章の境界をまたぐ ♪=参考音源の章 ?=60秒未満。
  演奏の頭から数秒だけ聴けば大半は判断できます。</div>
</main>
<script>
const D=__DATA__, KEY='segrev:'+D.vid;
let st=JSON.parse(localStorage.getItem(KEY)||'{}'), cur=0;
const hms=s=>{s=Math.round(s);return `${Math.floor(s/3600)}:${String(Math.floor(s%3600/60)).padStart(2,'0')}:${String(s%60).padStart(2,'0')}`};
const esc=s=>(s||'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
const save=()=>localStorage.setItem(KEY,JSON.stringify(st));
function list(){
 document.getElementById('list').innerHTML=D.items.map((it,i)=>{
  const v=(st[it.n]||{}).verdict||'';
  return `<div class="row ${i===cur?'cur':''}" data-i="${i}">
   <span class="dot ${v}"></span><span>${it.mark}${String(it.n).padStart(2,'0')}</span>
   <span style="color:var(--dim)">${hms(it.start)}</span></div>`}).join('');
 document.querySelectorAll('.row').forEach(r=>r.onclick=()=>{cur=+r.dataset.i;show()});
 const done=D.items.filter(it=>(st[it.n]||{}).verdict).length;
 document.getElementById('pbar').style.width=(done/D.items.length*100)+'%';
 document.getElementById('cnt').textContent=`${done} / ${D.items.length} 判定済み`;}
function show(seek){
 const it=D.items[cur], s=st[it.n]||{};
 document.getElementById('ttl').textContent=`${it.mark}${String(it.n).padStart(2,'0')}　${it.chapter||''}`;
 document.getElementById('chip').textContent=`${hms(it.start)}–${hms(it.end)}（${(it.dur/60).toFixed(1)}分）`;
 document.getElementById('pos').textContent=`${cur+1} / ${D.items.length}`;
 document.getElementById('yt').src=
  `https://www.youtube.com/embed/${D.vid}?start=${Math.round(seek??it.cue)}&rel=0`;
 document.getElementById('before').innerHTML=it.before.map(([t,x])=>
  `<p class="q"><b>${hms(t)}</b> ${esc(x)}</p>`).join('')||'<p class="q">（なし）</p>';
 document.getElementById('after').innerHTML=it.after.map(([t,x])=>
  `<p class="q"><b>${hms(t)}</b> ${esc(x)}</p>`).join('')||'<p class="q">（なし）</p>';
 document.getElementById('note').value=s.note||'';
 document.querySelectorAll('button[data-v]').forEach(b=>
  b.classList.toggle('on',['play','no','hold'].includes(b.dataset.v)&&b.dataset.v===s.verdict));
 list();}
function mark(v){const it=D.items[cur];st[it.n]={...(st[it.n]||{}),verdict:v,
 note:document.getElementById('note').value};save();
 if(cur<D.items.length-1){cur++;show()}else show();}
document.querySelectorAll('button[data-v]').forEach(b=>b.onclick=()=>{
 const v=b.dataset.v;
 if(['play','no','hold'].includes(v))mark(v);
 else if(v==='next'&&cur<D.items.length-1){cur++;show()}
 else if(v==='prev'&&cur>0){cur--;show()}
 else if(v==='replay')show(D.items[cur].start);
 else if(v==='export'){
  const rows=D.items.map(it=>({n:it.n,start:hms(it.start),end:hms(it.end),
   dur_sec:Math.round(it.dur),chapter:it.chapter,mark:it.mark,
   verdict:(st[it.n]||{}).verdict||'',note:(st[it.n]||{}).note||''}));
  const blob=new Blob([JSON.stringify({video:D.vid,reviewed_at:new Date().toISOString(),
   items:rows},null,2)],{type:'application/json'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);
  a.download='segments_verdict.json';a.click();}});
document.getElementById('note').addEventListener('change',()=>{
 const it=D.items[cur];st[it.n]={...(st[it.n]||{}),note:document.getElementById('note').value};save()});
addEventListener('keydown',e=>{
 if(e.target.tagName==='INPUT')return;
 const k=e.key.toLowerCase();
 if(k==='1')mark('play');else if(k==='2')mark('no');else if(k==='3')mark('hold');
 else if(k==='k'&&cur<D.items.length-1){cur++;show()}
 else if(k==='j'&&cur>0){cur--;show()}
 else if(k==='r')show(D.items[cur].start);});
show();
</script></body></html>"""

NOISE = re.compile(r"^[\sはいえっとあのうんそうねまあ、。？?！!ーっ]*$")


def die(msg: str, code: int = 1) -> None:
    print(f"segments-review: error: {msg}", file=sys.stderr)
    sys.exit(code)


def hms(sec: float) -> str:
    s = int(sec)
    return f"{s//3600}:{s%3600//60:02d}:{s%60:02d}"


def load_srt(path: Path) -> list:
    out = []
    for m in CUE_RE.finditer(path.read_text(encoding="utf-8")):
        g = m.groups()
        s = int(g[0])*3600 + int(g[1])*60 + int(g[2]) + int(g[3].ljust(3, "0"))/1000
        t = re.sub(r"\[spk(\d+)\]\s*", r"", g[8].strip().replace("\n", ""))
        spk = re.match(r"\[spk(\d+)\]", g[8].strip())
        if t:
            out.append((s, t, spk.group(1) if spk else ""))
    return out


def similar(a: str, b: str) -> float:
    """文字集合の重なり。表記揺れがあっても同一発話なら高くなる。"""
    sa, sb = set(a), set(b)
    if not sa or not sb:
        return 0.0
    return len(sa & sb) / min(len(sa), len(sb))


def merge_engines(streams: list, win: float, keep_sim: float) -> list:
    """同じ発話の別エンジン版・断片を畳む。

    エンジン間で同一発話の時刻が数秒ずれる（Whisper は長い区間を1 cue にまとめ、
    Deepgram は細かく切る）ので、時刻のクラスタリングだけでは畳めない。
    **長い版から順に採用し、その前後 win 秒に似た版があれば断片として捨てる**。
    要約ではなく選択なので、残るのは必ず実在の発話。
    """
    allc = [c for st in streams for c in st]
    allc.sort(key=lambda c: (-len(c[1]), c[0]))
    kept: list = []
    for c in allc:
        dup = False
        for k in kept:
            if abs(c[0] - k[0]) <= win and similar(c[1], k[1]) >= keep_sim:
                dup = True
                break
        if not dup:
            kept.append(c)
    return sorted(kept, key=lambda c: c[0])


def load_chapters(path: Path) -> list:
    out = []
    for line in path.read_text(encoding="utf-8").splitlines():
        m = CHAP_RE.match(line)
        if m:
            g = m.groups()
            out.append((int(g[0])*3600 + int(g[1])*60 + int(g[2]), g[4]))
    return sorted(out)


def main() -> int:
    ap = argparse.ArgumentParser(prog="segments-review", add_help=True)
    ap.add_argument("--segments", required=True, help="segments-detect の json")
    ap.add_argument("--sub", action="append", default=[], required=True,
                    help="字幕 SRT（複数指定可。3系統あるほど取りこぼしが減る）")
    ap.add_argument("--chapters", help="章立て txt（あれば区間に章名を付ける）")
    ap.add_argument("-o", "--out", default="review.md")
    ap.add_argument("--chapters-out", metavar="FILE",
                    help="Chaptr で読める確認用チャプターも書く。**指示が始まる時刻**に打ち、"
                         "タイトルに 番号/長さ/曲/指示の冒頭 を入れる。動画を見ながら"
                         "確認するのに使う（review.md と番号が対応する）")
    ap.add_argument("--html-out", metavar="FILE",
                    help="ブラウザで確認するための単一HTMLを書く。YouTube を埋め込み、"
                         "その場で聴いてボタンで判定できる。判定は localStorage に自動保存され、"
                         "最後に JSON で書き出す。--youtube-id が要る")
    ap.add_argument("--youtube-id", default="",
                    help="YouTube の動画ID。**記録と同一タイムラインの動画**であること")
    ap.add_argument("--before", type=float, default=90, help="直前を何秒さかのぼるか")
    ap.add_argument("--after", type=float, default=60, help="直後を何秒見るか")
    ap.add_argument("--min-dur", type=float, default=20,
                    help="この秒数未満の区間は出さない（口唱・物音の除去）")
    ap.add_argument("--merge-gap", type=float, default=45,
                    help="この秒数以内で途切れた区間は1回の演奏とみなす")
    ap.add_argument("--dup-window", type=float, default=10.0,
                    help="この秒数以内の似た発話は同一とみなして畳む")
    ap.add_argument("--dup-sim", type=float, default=0.62,
                    help="この類似度以上なら同一発話とみなす")
    ap.add_argument("--min-chars", type=int, default=6,
                    help="この文字数未満の断片は出さない")
    ap.add_argument("--force", action="store_true", help="出力先があっても上書き")
    args = ap.parse_args()

    segs = json.loads(Path(args.segments).read_text(encoding="utf-8"))
    if not segs:
        die("segments が空です")
    streams = []
    for sp in args.sub:
        p = Path(sp)
        if not p.is_file():
            die(f"sub not found: {p}")
        streams.append(load_srt(p))
    cues = merge_engines(streams, args.dup_window, args.dup_sim)
    chaps = load_chapters(Path(args.chapters)) if args.chapters else []
    out = Path(args.out)
    if out.exists() and not args.force:
        die(f"出力先が既にあります: {out}（--force で上書き）")

    # 演奏区間の統合
    segs = sorted(segs, key=lambda s: s["start"])
    ev = []
    for s in segs:
        if ev and s["start"] - ev[-1]["end"] <= args.merge_gap:
            ev[-1]["end"] = max(ev[-1]["end"], s["end"])
        else:
            ev.append({"start": s["start"], "end": s["end"]})
    ev = [e for e in ev if e["end"] - e["start"] >= args.min_dur]

    def chap_of(t):
        cur = ""
        for cs, ct in chaps:
            if cs <= t:
                cur = ct
            else:
                break
        return cur

    def span(a, b):
        return [c for c in cues if a <= c[0] < b and not NOISE.match(c[1])
                and len(re.sub(r"[\s、。？?！!ー・]", "", c[1])) >= args.min_chars]

    lines = [f"# 合奏ごとの確認シート", "",
             f"演奏 {len(ev)} 件 / 直前 {args.before:g}秒・直後 {args.after:g}秒 を抜粋。",
             "字幕は原文のまま（要約・校正なし）。複数エンジンのうち最も長い版を代表にし、",
             "内容が大きく違う版は併記している。", ""]
    prev_ch = None
    for i, e in enumerate(ev, 1):
        ch = chap_of(e["start"])
        if ch != prev_ch:
            lines += ["", f"## {ch or '（章なし）'}", ""]
            prev_ch = ch
        dur = e["end"] - e["start"]
        lines.append(f"### {i:02d}. {hms(e['start'])}–{hms(e['end'])} "
                     f"（{dur/60:.1f}分）")
        lines.append("")
        lines.append("- [ ] 確認済み")
        lines.append("")
        before = span(e["start"] - args.before, e["start"])
        after = span(e["end"], e["end"] + args.after)
        lines.append("**直前の指示**")
        lines += [f"- `{hms(t)}` {tx}" for t, tx, _ in before[-8:]] or ["- （なし）"]
        lines.append("")
        lines.append("**直後の講評**")
        lines += [f"- `{hms(t)}` {tx}" for t, tx, _ in after[:8]] or ["- （なし）"]
        lines.append("")

    out.write_text("\n".join(lines) + "\n", encoding="utf-8")


    if args.html_out:
        if not args.youtube_id:
            die("--html-out には --youtube-id が要ります")
        items = []
        for i, e in enumerate(ev, 1):
            ch = chap_of(e["start"])
            dur = e["end"] - e["start"]
            mark = ("※" if chap_of(e["end"] - 1) != ch else "") \
                 + ("♪" if "参考音源" in ch else "") + ("?" if dur < 60 else "")
            b = span(e["start"] - args.before, e["start"])[-6:]
            a = span(e["end"], e["end"] + args.after)[:6]
            items.append({
                "n": i, "mark": mark, "chapter": ch,
                "start": e["start"], "end": e["end"], "dur": dur,
                "cue": (b[-1][0] if b else e["start"]),
                "before": [[t, tx] for t, tx, _ in b],
                "after": [[t, tx] for t, tx, _ in a],
            })
        payload = json.dumps({"vid": args.youtube_id, "items": items}, ensure_ascii=False)
        Path(args.html_out).write_text(HTML_APP.replace("__DATA__", payload),
                                       encoding="utf-8")
        print(f"segments-review: wrote {args.html_out}（ブラウザで開いて判定する）",
              file=sys.stderr)

    if args.chapters_out:
        # 確認用チャプター。人が動画を見ながら潰すためのもので、章立てそのものではない。
        # 先頭の記号で「どこを重点的に見るべきか」を示す:
        #   ※ 章の境界をまたぐ（帰属が怪しい） / ♪ 参考音源の章にある（再生かも）
        #   ? 短い（口唱・物音の可能性）
        co = []
        for i, e in enumerate(ev, 1):
            ch = chap_of(e["start"])
            dur = e["end"] - e["start"]
            mark = ""
            if chap_of(e["end"] - 1) != ch:
                mark += "※"
            if "参考音源" in ch:
                mark += "♪"
            if dur < 60:
                mark += "?"
            before = span(e["start"] - args.before, e["start"])
            head = before[-1][1] if before else ""
            head = re.sub(r"^[。、\s]+", "", head)[:26]
            # 指示の始まりに打つ（そこから再生すれば「なぜ返したか」から聴ける）
            t = before[-1][0] if before else e["start"]
            ms = int(round(t * 1000))
            co.append(f"{ms//3600000}:{ms//60000%60:02d}:{ms//1000%60:02d}.{ms%1000:03d} "
                      f"{mark}{i:02d} {dur/60:.1f}分 {ch} ／ {head}")
        Path(args.chapters_out).write_text("\n".join(co) + "\n", encoding="utf-8")
        print(f"segments-review: wrote {args.chapters_out}（Chaptr 用・確認チャプター）",
              file=sys.stderr)

    print(f"segments-review: wrote {out}  （演奏 {len(ev)} 件 / {len(cues)} 発話から抽出）",
          file=sys.stderr)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
