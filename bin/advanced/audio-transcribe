#!/usr/bin/env python3
"""
audio-transcribe — 動画/音声から「忠実な一次資料」を CLI で生成する（Whisper 系）。

faster-whisper(CTranslate2) を stable-ts から回し、次の 2 + 1 層を同時出力する:

    <base>.srt         可読な一次テキスト層（時系列・媒体へ遡及可能）
    <base>.words.json  機械忠実層（word 単位タイムスタンプ + 語ごとの確信度 probability）
    <base>.meta.json   来歴（モデル/パラメータ/ツール版/入力の同一性 sha256）

一次資料としての設計方針:
    - 出力は ASR の生結果。校正はしない（校正は派生の解釈層で行い、ここへ書き戻さない）
    - probability を保持するので「どこが怪しいか」が後から分かる
    - すべての cue/語が媒体の時刻へ遡れる
    - meta.json に来歴（入力の sha256 を含む）を残し、再現とトレーサビリティを担保する
    - 既存の一次資料を黙って壊さない（出力先が既にあれば停止。上書きは --force）

既定は large-v3（full）。語単位タイムスタンプと語ごと probability が取れるので、
別エンジン（audio-transcribe-dg = Deepgram Nova-3）との突き合わせに耐える。
Kotoba-Whisper v2.0 は distil のため word timestamps 非対応で、--model で選ぶと
自動的に segment 単位へ落ちる（速度優先のとき用）。

固有名詞・専門語彙（曲名・楽器名・音楽用語・人名）は --terms で注入する。
同じ語彙ファイルを audio-transcribe-dg の --terms（Deepgram keyterm）にも渡せる。

依存（初回のみ導入。CTranslate2 バックエンドなので推論は torch 不要・CPUで実用）:
    pip install -U stable-ts faster-whisper
    # モデルは初回実行時に HuggingFace から自動DL（large-v3 は ~3GB）

Usage:
    audio-transcribe input.wav
    audio-transcribe input.wav -o 20260802_practice --terms terms.txt
    audio-transcribe input.mp4 --model kotoba-tech/kotoba-whisper-v2.0-faster  # 速度優先
    audio-transcribe input.mp4 --compute-type int8 --beam 5 --vad
    audio-transcribe input.mp4 --dry-run          # 計画のみ（依存の import もしない）

参考: 話者分離まで要るなら kotoba-whisper v2.2 系 or WhisperX を別途検討。
"""
from __future__ import annotations

import argparse
import hashlib
import inspect
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

# macOS で torch(libomp) と ctranslate2 の OpenMP が二重ロードされると
# 推論中に segfault する。stable_whisper を import する前に緩和しておく。
os.environ.setdefault("KMP_DUPLICATE_LIB_OK", "TRUE")

DEFAULT_MODEL = "large-v3"

# word timestamps を持てないモデル（distil 系）。指定されたら segment 単位へ落とす。
DISTIL_HINTS = ("kotoba", "distil")

# ASR にとって素性が良い（非圧縮/可逆）コーデック。これ以外は警告する。
LOSSLESS_CODECS = {"pcm_s16le", "pcm_s24le", "pcm_s32le", "pcm_f32le", "pcm_f64le",
                   "flac", "alac", "wavpack", "tta"}


def die(msg: str, code: int = 1) -> None:
    print(f"audio-transcribe: error: {msg}", file=sys.stderr)
    sys.exit(code)


def log(msg: str) -> None:
    print(msg, file=sys.stderr)


def probe_duration(path: Path) -> float | None:
    try:
        r = subprocess.run(
            ["ffprobe", "-v", "error", "-show_entries", "format=duration",
             "-of", "csv=p=0", str(path)],
            capture_output=True, text=True, check=False,
        )
        return float(r.stdout.strip())
    except (ValueError, FileNotFoundError):
        return None


def probe_audio(path: Path) -> dict:
    """先頭の音声ストリームの素性（codec/bit_rate/sample_rate/channels）を返す。"""
    try:
        r = subprocess.run(
            ["ffprobe", "-v", "error", "-select_streams", "a:0",
             "-show_entries", "stream=codec_name,bit_rate,sample_rate,channels",
             "-of", "json", str(path)],
            capture_output=True, text=True, check=False,
        )
        streams = json.loads(r.stdout).get("streams") or []
        return streams[0] if streams else {}
    except (ValueError, FileNotFoundError, json.JSONDecodeError):
        return {}


def warn_lossy(info: dict) -> None:
    """非可逆・低ビットレート入力は精度の天井を下げるので、実行前に警告する。"""
    codec = info.get("codec_name")
    if not codec or codec in LOSSLESS_CODECS:
        return
    try:
        kbps = int(info.get("bit_rate") or 0) // 1000
    except (TypeError, ValueError):
        kbps = 0
    detail = f"{codec}" + (f" {kbps}kbps" if kbps else "")
    log(f"  warning    : 非可逆入力です（{detail}）。"
        "精度優先なら原盤の WAV/FLAC を入力にしてください")
    if kbps and kbps <= 96:
        log("  warning    : ビットレートが低く、量子化歪みが ASR 帯域(0-8kHz)にも乗ります")


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def read_terms(path: Path) -> list:
    """語彙ファイルを読む。1行1語、# 以降はコメント、空行は無視。

    同じファイルを audio-transcribe-dg（Deepgram keyterm）にも渡せるよう書式を揃える。
    """
    terms = []
    for line in path.read_text(encoding="utf-8").splitlines():
        term = line.split("#", 1)[0].strip()
        if term:
            terms.append(term)
    return terms


def supported_kwargs(fn, wanted: dict) -> tuple:
    """fn が受け取れる kwargs だけを残す。落としたキーも返す。

    stable-ts は版によって faster-whisper への転送方法が違い、hotwords を
    受けられないことがある。黙って無視されると「効いているつもり」になるので、
    落ちたことを明示する。
    """
    try:
        params = inspect.signature(fn).parameters
    except (TypeError, ValueError):
        return dict(wanted), []
    if any(p.kind is inspect.Parameter.VAR_KEYWORD for p in params.values()):
        return dict(wanted), []
    ok = {k: v for k, v in wanted.items() if k in params}
    return ok, [k for k in wanted if k not in ok]


def guard_outputs(paths: list, force: bool) -> None:
    """既存の一次資料を黙って上書きしない。"""
    if force:
        return
    existing = [p for p in paths if p.exists()]
    if existing:
        die("出力先が既にあります（一次資料を上書きしません）:\n"
            + "\n".join(f"  {p}" for p in existing)
            + "\n別の -o を指定するか、意図した上書きなら --force を付けてください")


def srt_time(sec: float) -> str:
    ms = int(round(max(sec, 0.0) * 1000))
    h, ms = divmod(ms, 3_600_000)
    m, ms = divmod(ms, 60_000)
    s, ms = divmod(ms, 1000)
    return f"{h:02d}:{m:02d}:{s:02d},{ms:03d}"


def write_srt(path: Path, segs: list) -> None:
    out = []
    for i, s in enumerate(segs, 1):
        text = (s.get("text") or "").strip()
        if not text:
            continue
        out.append(str(i))
        out.append(f"{srt_time(s['start'])} --> {srt_time(s['end'])}")
        out.append(text)
        out.append("")
    path.write_text("\n".join(out), encoding="utf-8")


def transcribe_chunked(tr, src: Path, chunk_sec: float, dur: float, kwargs: dict) -> list:
    """尺を chunk_sec ごとに切って個別に転写し、時刻をずらして結合する。

    なぜ必要か: 全長を一度に渡すと、VAD が無音を除いた圧縮タイムライン上で
    デコードしてから実時間へ戻すため、除去区間をまたぐセグメントの終端が
    引き伸ばされる（実測: 数秒の発話が 1086 秒の cue になる）。
    Silero VAD は音楽を発話と判定するので、演奏区間ではこれが顕著に出る。
    同じ区間を単独で処理すれば正常なので、切ってから渡す。
    """
    segs: list = []
    n = max(1, int(dur // chunk_sec) + (1 if dur % chunk_sec else 0))
    with tempfile.TemporaryDirectory(prefix="audio-transcribe-chunk-") as td:
        for i in range(n):
            ss = i * chunk_sec
            piece = Path(td) / f"chunk{i:04d}.wav"
            r = subprocess.run(
                ["ffmpeg", "-nostdin", "-v", "error", "-ss", f"{ss:.3f}",
                 "-t", f"{chunk_sec:.3f}", "-i", str(src),
                 "-ac", "1", "-ar", "16000", "-c:a", "pcm_s16le", str(piece)],
                capture_output=True, text=True, check=False)
            if r.returncode != 0 or not piece.is_file() or piece.stat().st_size < 2000:
                continue
            log(f"    chunk {i+1}/{n}  ({ss/60:.1f}-{min(ss+chunk_sec, dur)/60:.1f}min)")
            res = tr(str(piece), **kwargs)
            for s in (getattr(res, "segments", []) or []):
                segs.append({
                    "start": float(s.start) + ss,
                    "end": float(s.end) + ss,
                    "text": s.text,
                    "avg_logprob": getattr(s, "avg_logprob", None),
                    "no_speech_prob": getattr(s, "no_speech_prob", None),
                    "compression_ratio": getattr(s, "compression_ratio", None),
                    "chunk": i,
                })
            piece.unlink(missing_ok=True)
    segs.sort(key=lambda s: s["start"])
    return segs


def pkg_version(name: str) -> str:
    try:
        from importlib.metadata import version
        return version(name)
    except Exception:
        return "unknown"


def main() -> int:
    ap = argparse.ArgumentParser(prog="audio-transcribe", add_help=True)
    ap.add_argument("input", help="動画/音声（ffmpeg が読めるもの）")
    ap.add_argument("-o", "--output", help="出力 basename（既定: 入力の stem）")
    ap.add_argument("--model", default=DEFAULT_MODEL,
                    help=f"faster-whisper/CT2 モデル (default: {DEFAULT_MODEL})")
    ap.add_argument("--language", default="ja", help="言語 (default: ja)")
    ap.add_argument("--device", default="auto", choices=["auto", "cpu", "cuda"],
                    help="推論デバイス (default: auto。Mac は cpu)")
    ap.add_argument("--compute-type", default="auto",
                    help="CT2 compute type: auto|int8|int8_float16|float16|float32")
    ap.add_argument("--beam", type=int, default=5, help="beam size (default: 5)")
    ap.add_argument("--vad", action="store_true",
                    help="faster-whisper の VAD で無音/非発話を除外（音楽での幻聴を抑制）")
    ap.add_argument("--no-condition", action="store_true",
                    help="condition_on_previous_text を無効化（反復幻聴を抑制。長尺・音楽混在で有効）")
    ap.add_argument("--word-timestamps", dest="word_timestamps", action="store_true",
                    default=True,
                    help="word 単位タイムスタンプ＋語ごと probability（既定: 有効）。"
                         "distil モデル指定時は自動で無効化される")
    ap.add_argument("--no-word-timestamps", dest="word_timestamps", action="store_false",
                    help="segment 単位に落とす（速度優先）")
    ap.add_argument("--word-srt", action="store_true",
                    help="SRT も word 単位で出す（word timestamps 有効時のみ）")
    ap.add_argument("--terms", metavar="FILE", action="append", default=[],
                    help="語彙ファイル（1行1語・# コメント可）を hotwords として注入する。"
                         "曲名/楽器名/音楽用語/人名。複数指定可（汎用リスト + テイク固有）。"
                         "同じファイルを audio-transcribe-dg にも渡せる")
    ap.add_argument("--prompt", metavar="TEXT",
                    help="initial_prompt。文体・表記の誘導に使う（語彙注入は --terms を推奨）")
    ap.add_argument("--chunk", type=float, metavar="MIN", default=0,
                    help="尺を MIN 分ごとに切って個別に転写し結合する（0=無効）。"
                         "長尺 + 音楽混在で cue 終端が引き伸ばされるのを防ぐ。"
                         "長い演奏を含む素材では 10 前後を推奨")
    ap.add_argument("--force", action="store_true",
                    help="出力先が既にあっても上書きする")
    ap.add_argument("--threads", type=int, default=4,
                    help="ctranslate2 CPU スレッド数 (default: 4)")
    ap.add_argument("--dry-run", action="store_true", help="計画のみ。依存の import もしない")
    ap.add_argument("-v", "--verbose", action="store_true")
    args = ap.parse_args()

    src = Path(args.input)
    if not src.is_file():
        die(f"input not found: {src}")
    base = Path(args.output) if args.output else src.with_suffix("")
    srt_path = Path(str(base) + ".srt")   # with_suffix はドット入り basename（例 2026.6.17_x）を壊す
    words_path = Path(str(base) + ".words.json")
    meta_path = Path(str(base) + ".meta.json")

    device = "cpu" if args.device == "auto" else args.device
    compute = args.compute_type
    if compute == "auto":
        compute = "int8" if device == "cpu" else "float16"

    # distil 系は word timestamps を持てない。黙って嘘の meta を書かないよう落とす。
    word_ts = args.word_timestamps
    is_distil = any(h in args.model.lower() for h in DISTIL_HINTS)
    if word_ts and is_distil:
        word_ts = False

    terms = []
    for tf in args.terms:
        tp = Path(tf)
        if not tp.is_file():
            die(f"terms file not found: {tp}")
        for t in read_terms(tp):
            if t not in terms:      # 重複は hotwords を薄めるだけなので落とす
                terms.append(t)

    dur = probe_duration(src)
    ainfo = probe_audio(src)
    log("audio-transcribe:")
    log(f"  input      : {src}" + (f"  ({dur/3600:.2f}h)" if dur else ""))
    warn_lossy(ainfo)
    log(f"  model      : {args.model}" + ("  (distil: segment 単位)" if is_distil else ""))
    log(f"  language   : {args.language}")
    log(f"  device     : {device} / compute={compute} / beam={args.beam}"
        f"{' / vad' if args.vad else ''}"
        f"{' / no-condition' if args.no_condition else ''}"
        f"{' / word-ts' if word_ts else ''}")
    if terms:
        log(f"  terms      : {len(terms)} 語 ({', '.join(args.terms)})")
    if word_ts is False and args.word_timestamps:
        log("  note       : distil モデルのため word timestamps を無効化しました")
    if (terms or args.prompt) and is_distil:
        log("  warning    : distil モデルはプロンプトを扱えないため語彙注入を無効化します"
            "（渡すと出力が丸ごと空になる。語彙注入は full モデルで）")
    hot = " ".join(terms) if terms and not is_distil else ""
    if len(hot) > 400:
        # Whisper のプロンプト枠は decoder context の半分（224 token）。
        # 日本語は 1 文字 ≈ 1 token 前後なので、長すぎる語彙は頭が切られる。
        log(f"  warning    : hotwords が {len(hot)} 文字あります。"
            "プロンプト枠(約224token)を超える分は無視されます。語彙を絞ってください")
    log(f"  outputs    : {srt_path.name}  {words_path.name}  {meta_path.name}")

    if args.dry_run:
        log("audio-transcribe: --dry-run（実行しません）")
        return 0

    guard_outputs([srt_path, words_path, meta_path], args.force)

    try:
        import stable_whisper
    except ImportError:
        die("stable-ts が見つかりません。導入してください:\n"
            "  pip install -U stable-ts faster-whisper\n"
            "（CTranslate2 バックエンドなので推論は torch 不要・CPUで実用）")

    log(f"  loading model（初回は HuggingFace から DL, ~1.5GB）...")
    model = stable_whisper.load_faster_whisper(
        args.model, device=device, compute_type=compute, cpu_threads=args.threads)

    log("  transcribing..." + ("（word 単位）" if word_ts else "（segment 単位）"))
    # transcribe_stable は新しめの stable-ts で transcribe に統合された。両対応。
    tr = getattr(model, "transcribe", None) or model.transcribe_stable

    # distil はプロンプトを扱えないので hot は空になっている（判定は計画段階で済み）。
    # 語彙注入は版によって受け口が違う。受けられない引数は落とし、落としたことを言う。
    wanted = {k: v for k, v in (("hotwords", hot),
                                ("initial_prompt", None if is_distil else args.prompt)) if v}
    extra, dropped = supported_kwargs(tr, wanted)
    if dropped:
        log(f"  warning    : この stable-ts/faster-whisper は {', '.join(dropped)} を"
            "受け付けません（注入せず続行）")

    tr_kwargs = dict(
        language=args.language,
        beam_size=args.beam,
        word_timestamps=word_ts,
        vad_filter=args.vad,
        condition_on_previous_text=not args.no_condition,
        verbose=args.verbose or None,
        **extra,
    )

    if args.chunk > 0:
        chunks = transcribe_chunked(tr, src, args.chunk * 60.0, dur or 0.0, tr_kwargs)
        # (1) 可読層 / (2) 機械忠実層 — 結合済みセグメントから自前で書く
        write_srt(srt_path, chunks)
        words_path.write_text(
            json.dumps({"segments": chunks, "language": args.language,
                        "text": "".join(s["text"] for s in chunks)},
                       ensure_ascii=False, indent=2), encoding="utf-8")
        seg = chunks
        nwords = 0
    else:
        result = tr(str(src), **tr_kwargs)
        # (1) 可読な一次テキスト層（既定 segment 単位。--word-srt は word 併用時のみ）
        word_srt = args.word_srt and word_ts
        result.to_srt_vtt(str(srt_path), word_level=word_srt, segment_level=True)
        # (2) 機械忠実層（word 単位 + probability を保持。再処理の元にもなる）
        result.save_as_json(str(words_path))
        seg = getattr(result, "segments", []) or []
        nwords = sum(len(getattr(s, "words", []) or []) for s in seg)
    meta = {
        "tool": "audio-transcribe",
        "input": {
            "path": str(src.resolve()),
            "bytes": src.stat().st_size,
            "sha256": sha256_file(src),
            "duration_sec": dur,
            "codec": ainfo.get("codec_name"),
            "sample_rate": ainfo.get("sample_rate"),
            "channels": ainfo.get("channels"),
            "bit_rate": ainfo.get("bit_rate"),
        },
        "asr": {
            "engine": "whisper",
            "backend": "faster-whisper (CTranslate2) via stable-ts",
            "model": args.model,
            "language": args.language,
            "device": device,
            "compute_type": compute,
            "beam_size": args.beam,
            "vad_filter": args.vad,
            "condition_on_previous_text": not args.no_condition,
            "word_timestamps": word_ts,
            "cpu_threads": args.threads,
            "chunk_minutes": args.chunk or None,
            "terms_files": args.terms,
            "terms_count": len(terms),
            "terms_applied": "hotwords" in extra,
            "initial_prompt": args.prompt,
        },
        "versions": {
            "stable-ts": pkg_version("stable-ts"),
            "faster-whisper": pkg_version("faster-whisper"),
            "ctranslate2": pkg_version("ctranslate2"),
        },
        "counts": {"segments": len(seg), "words": nwords},
        "outputs": {"srt": srt_path.name, "words_json": words_path.name},
        "note": "ASR の生出力。校正はしていない（校正は派生の解釈層で行う）。"
                "probability は語ごとの確信度。",
    }
    meta_path.write_text(json.dumps(meta, ensure_ascii=False, indent=2),
                         encoding="utf-8")

    log(f"audio-transcribe: wrote {srt_path.name} / {words_path.name} / {meta_path.name}"
        f"  (segments={len(seg)}, words={nwords})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
